[Unit]
Description=SmartVault API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/smartvault-api
EnvironmentFile=/opt/smartvault-api/.env
ExecStart=/usr/bin/node /opt/smartvault-api/server.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
